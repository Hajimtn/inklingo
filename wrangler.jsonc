// Cloudflare Workers config (free plan). Deploy: npm run deploy   Local: npm run cf:dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inklingo",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Links like /room/ABCDE open the app; the hash router takes it from there.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // The free plan only has SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true }
}
