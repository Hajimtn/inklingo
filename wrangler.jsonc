// Cloudflare Workers config (free plan). Deploy: npm run deploy   Local: npm run cf:dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inklingo",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Links like /room/ABCDE open the app; the hash router takes it from there.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // The free plan only has SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // The domain is bought at Tenten; its nameservers point to Cloudflare, which creates the DNS
  // records for these on deploy.
  // inklingo.inklingo.workers.dev keeps working too.
  "workers_dev": true,
  "routes": [
    { "pattern": "inklingo.io.vn", "custom_domain": true },
    { "pattern": "www.inklingo.io.vn", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
